{
  "name": "clipt-chrome-extension",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/gen-icons.mjs && tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "zip": "npm run build && cd dist && zip -qr ../Clipverse-Chrome-Extension-MV3.zip ."
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
