#!/bin/sh
# Gradle wrapper launcher (POSIX). Downloads the Gradle version pinned in
# gradle/wrapper/gradle-wrapper.properties on first run.
APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ -n "$JAVA_HOME" ]; then
  JAVACMD=$JAVA_HOME/bin/java
else
  JAVACMD=java
fi
if ! command -v "$JAVACMD" >/dev/null 2>&1; then
  echo "ERROR: Java not found. Install JDK 17+ or set JAVA_HOME." >&2
  exit 1
fi
exec "$JAVACMD" $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=gradlew" \
  -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
